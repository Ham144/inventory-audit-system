{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./",
    "resolveJsonModule": true
  },
  "include": [
    "index.ts",
    "config/**/*.ts",
    "routes/**/*.ts",
    "types/**/*.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules", "dist", "generated"]
}

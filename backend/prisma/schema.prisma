// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model OpnameSession {
  id               String             @id @default(uuid())
  name             String // Nama sesi opname (misal: "Opname Mei 2026")
  office           String
  status           String             @default("ONGOING") // ONGOING, COMPLETED
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  scans            ScanLog[]
  compareItems     CompareItem[]  
  scanQtyApprovals ScanQtyApproval[]
}

model ScanLog {
  id           String   @id @default(uuid())
  sku          String // SKU barang / No dari ERP (contoh: "SRCEZ18DGR")
  name         String // Deskripsi barang
  rak          Int // Spesifik rak (contoh: 1)
  qty          Int // Jumlah fisik hasil scan
  operator     String // Username petugas lapangan
  createdAt    DateTime @default(now())
  office String // Wilayah / Lokasi gudang
  
  sessionId String
  session   OpnameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  approval ScanQtyApproval?

  @@index([sku])
  @@index([sessionId])
}

model ScanQtyApproval {
  id           String   @id @default(uuid())
  sku          String
  rak          Int
  office String
  scanLogId    String   @unique
  approvedQty  Int
  approvedBy   String
  approvedAt   DateTime @default(now())

  sessionId String
  session   OpnameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scanLog   ScanLog       @relation(fields: [scanLogId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sku, rak, office])
  @@index([sessionId])
}

//ini state terbaru compare nav
model CompareItem {
  id          String   @id @default(uuid())
  sku         String
  name        String
  physicalQty Int      @default(0)
  systemQty   Int      @default(0)
  status      String   @default("BELUM_COMPARE") // SESUAI, SELISIH, BELUM_COMPARE
  note        String?
  updatedAt   DateTime @default(now())
  
  // Final correction: admin override for physicalQty, bypassing rak-level logic
  finalCorrectionQty Int?
  finalCorrectionBy  String?
  finalCorrectionAt  DateTime?
  finalCorrectionRak Int?

  // Delegation: admin assigns a user to re-check this SKU
  delegatedTo String?
  delegatedBy String?
  delegatedAt DateTime?
  
  sessionId String
  session   OpnameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  @@unique([sessionId, sku])
}

model User {
  username  String   @id
  mongooseId String? 
  role      String   @default("operator") // operator, admin, owner
  office    String?
  type      String   @default("external") // external (LDAP) or app (Non-AD)
  tracingInputs TracingInput[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficeMapping {
  id           String   @id @default(uuid())
  officeName   String   // e.g. "WL Pluit"
  locationCode String   @unique // e.g. "PLUIT_JUAL"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TracingInput {
  id String @id @default(uuid())
  username String
  user User @relation(fields: [username], references: [username], onDelete: Cascade)
  physicalQty Int @default(0)
  office String
  sku String
  rak Int
  createdat DateTime @default(now())
}

//ini pengenal sku yang belum dikerjakan sama sekali tiap bulan, ketika create new: maka prosesnya => skuReminder.collectdata -> update tiap sku reminder dengan kosongkan resolvedOffices nya (create jika baru) -> update startPeriod dan EndPeriod nya
model SkuReminder {
  id String @id @default(uuid())
  sku String @unique
  resolvedOffices String[]
}
